{
  "name": "frj-for-sale-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test",
    "types": "wrangler types",
    "smoke": "node tools/smoke.mjs https://frj-for-sale-api.merlin-merzhin-lesage.workers.dev",
    "deploy": "wrangler deploy",
    "db:build-seed": "python tools/build_seed.py",
