    "db:seed:local": "node tools/apply_seed.mjs --local",
    "db:seed:remote": "node tools/apply_seed.mjs --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "wrangler": "^4.0.0"
  }
